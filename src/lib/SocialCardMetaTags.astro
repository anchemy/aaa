---
interface Props {
  ogImage: string | undefined;
}

let { ogImage } = Astro.props;

if (ogImage && ogImage.startsWith("/api/og")) {
  try {
    const baseUrl = import.meta.env.PUBLIC_URL || import.meta.env.SITE;
    if (baseUrl) {
      ogImage = new URL(ogImage, baseUrl).href;
    }
  } catch {
    // If URL construction fails, keep the original ogImage
  }
}
---

{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={ogImage} />
    </>
  )
}
