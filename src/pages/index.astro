---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Link } from "../lib/Link";
import { Paragraph } from "../lib/prose/Paragraph";
import { sitePages, sitePageHref } from "../lib/sitePages";
---

<BaseLayout
  title="zaduma"
  description="Astro starter template for understated personal websites using Solid.js, Tailwind CSS, and MDX."
>
  <h1 slot="header-content" class="text-gray-600 dark:text-gray-500">zaduma</h1>
  <main class="zaduma-prose py-10">
    <Paragraph>
      <small class="text-gray-600 dark:text-gray-500"
        >IPA /zaˈdu.ma/ — reverie, musing</small
      >
      <br />
      is an Astro starter template for understated personal websites
    </Paragraph>
    <Paragraph class="mt-6">
      Learn about it by reading the articles below, take a look at the
      <Link href="https://github.com/hasparus/zaduma">readme</Link>, or boldly
      <Link href="https://github.com/hasparus/zaduma/generate">
        {"create a new repository"}
      </Link>. I wish you a pleasant journey.
    </Paragraph>
  </main>
  <ul>
    {
      sitePages.map((page) => (
        <li>
          <Link
            href={sitePageHref(page.slug)}
            class="flex flex-row justify-between gap-2"
            noUnderline
          >
            <h2 class="font-sans text-gray-800 dark:text-gray-300">
              {page.title}
            </h2>
            <span
              class="page-description shrink-0 tabular-nums tracking-tighter text-gray-600 dark:text-gray-400"
            >
              {page.description}
            </span>
          </Link>
        </li>
      ))
    }
  </ul>
  <style>
    ul:hover li:not(:hover) :where(h2, .page-description) {
      @apply text-gray-600 transition-colors;
      :global(.dark) & {
        @apply text-gray-500;
      }
    }
  </style>
</BaseLayout>
